{
  "name": "@axphia/circlecode",
  "version": "1.1.8",
  "description": "High-performance, dependency-free circular barcode encoder & decoder with native WebAssembly and Mobile/C FFI acceleration for Browser, Node.js, Flutter, iOS, Android, and C++.",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "browser": "./dist/circlecode.umd.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "circle-code.js",
    "circle-scanner.js",
    "scanner-worker.js",
    "dist",
    "wasm",
    "native/include",
    "native/bindings"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./encoder": {
      "types": "./index.d.ts",
      "import": "./circle-code.js",
      "require": "./index.cjs"
    },
    "./scanner": {
      "types": "./index.d.ts",
      "import": "./circle-scanner.js",
      "require": "./index.cjs"
    },
    "./worker": "./scanner-worker.js",
    "./wasm": {
      "types": "./wasm/index.d.ts",
      "import": "./wasm/index.js"
    }
  },
  "scripts": {
    "dev": "npx serve .",
    "test": "node test/test.js && node test/test-generator.js",
    "test:wasm": "node test/test-wasm.js",
    "build": "node scripts/build.js",
    "build:wasm": "cd native/rust && wasm-pack build --target web --release",
    "build:native": "cd native/rust && cargo build --release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axphia/CircleCode.git"
  },
  "keywords": [
    "circlecode",
    "barcode",
    "circular-barcode",
    "qr-code",
    "scanner",
    "encoder",
    "decoder",
    "svg",
    "canvas",
    "webcam",
    "wasm",
    "flutter",
    "swift",
    "android",
    "ffi"
  ],
  "author": "Axphia Project",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Axphia/CircleCode/issues"
  },
  "homepage": "https://circlecode.js.org",
  "publishConfig": {
    "access": "public"
  }
}
